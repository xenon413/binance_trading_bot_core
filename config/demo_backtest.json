{
    "trading_bot_settings":{
        "target":"Engine",
        "kwargs":{
            "engine_settings":{
                "mode":"BACKTEST",
                "symbol":"BTCUSDC",
                "margin_buffer":"0.99",
                "margin_limit":[0, 500],
                "init_margin_asset_balance":200
            },
            "signal_settings":{
                "df_config":{
                    "main":{
                        "symbol":"BTCUSDC",
                        "interval":"1m",
                        "path":"backtest/sim_data/demo/btcusdc_1m.csv",
                        "index":{
                            "sma_index":{
                                "sma_long":{
                                    "window":320,
                                    "base_price":"close_price"
                                },
                                "sma_short":{
                                    "window":5,
                                    "base_price":"close_price"
                                }
                            },
                            "sma_cross":{
                                "sma_long_short_cross":{
                                    "sma1":"sma_short",
                                    "sma2":"sma_long"
                                }
                            }
                        }
                    }
                },
                "df_config_order":[
                    ["main", "sma_index", "sma_short"],
                    ["main", "sma_index", "sma_long"],
                    ["main", "sma_cross", "sma_long_short_cross"]
                ]
            },
            "strat_settings":{
                "target":"DemoStrat",
                "kwargs":{
                    "strat_config":{
                        "leverage":{
                            "base":1
                        },
                        "others":{
                            "tp_pct":"0.001",
                            "sl_pct":"0.002",
                            "cancel_timer":180000
                        }
                    }
                }
            }
        }
    },
    
    "worker_settings":{
        "wifi_monitor1_handle":{
            "target":"WifiMonitor1",
            "kwargs":{
                "rest":null
            }
        },
        "wifi_monitor2_handle":{
            "target":"WifiMonitor2",
            "kwargs":{
                "rest":null
            }
        },
        "wifi_monitor3_handle":{
            "target":"WifiMonitor3",
            "kwargs":{
                "rest":null
            }
        },
        "time_sync_handle":{
            "target":"TimeSync",
            "kwargs":{
                "thresh":null,
                "ntp_server":null,
                "cycle":null
            }
        },
        "ram_monitor":{
            "target":"RamMonitor",
            "kwargs":{}
        }
    }

}